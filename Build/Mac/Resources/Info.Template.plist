<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	ONE BRAHAM - macOS Info.plist template.

	UnrealBuildTool merges this into the game's Info.plist (it is the project's
	TemplateMacPlist, the default path in [/Script/MacTargetPlatform.XcodeProjectSettings]).
	It is the engine's own template plus one key:

	NSMicrophoneUsageDescription - required for voice chat. Without it macOS
	terminates the game the moment the microphone is opened; with it, the first
	match shows the system prompt with this text. If the player refuses, voice
	chat is listen-only and the HUD shows the microphone as unavailable
	(see Source/OneBraham/Voice/OneBrahamMicrophonePermission.h).
-->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSHighResolutionCapable</key>
	<false/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>ON BREAK uses your microphone for proximity and squad voice chat.</string>
</dict>
</plist>
